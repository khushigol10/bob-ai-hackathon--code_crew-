# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM watsonx.ai (AI assistant) ──────────────────────────────────────────
# Required to enable AI-generated explanations.
# Without these the assistant returns structured data only (fallback mode).
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Optional — defaults to ibm/granite-3-8b-instruct
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Database (if used) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ── Application ────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# ── Notifications (optional) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Add your project-specific variables below
